
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lista_zakupow.MainPage">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Text="Add task"
                x:Name="AddButton"
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="1"
                MaximumHeightRequest="50"
                Clicked="AddButton_Clicked"
                Style="{StaticResource AddButtonStyle}"
                ></Button>
        <Button Text="Add task by QR"
            x:Name="AddQR"
            Grid.Row="0"
            Grid.Column="1"
            Grid.ColumnSpan="1"
            MaximumHeightRequest="50"
            Clicked="AddQR_Clicked" 
            Style="{StaticResource AddButtonStyle}"
            ></Button>
        <Button Text="Delete tasks"
            Grid.Row="0"
            Grid.Column="2"
            Grid.ColumnSpan="1"
            MaximumHeightRequest="50"
            Clicked="Delete_Button_Clicked"
            Style="{StaticResource DeleteButtonStyle}"></Button>
        <CollectionView ItemsSource="{Binding Products}"
                        x:Name="list"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        SelectionMode="Single"
                        Style="{StaticResource listStyle}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" 
                           TextColor="DarkRed"
                          
                    ></Label>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal"></VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#e6be8f" ></Setter>
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Save tasks"
        Grid.Row="2"
        Grid.Column="1"
        MaximumHeightRequest="50"
        Clicked="SaveButton_Clicked"
        Style="{StaticResource AddButtonStyle}"></Button>
        <Button Text="Edit tasks"
                Grid.Row="2"
                Grid.Column="0"
                x:Name="EditButton"
                MaximumHeightRequest="50"
                Clicked="EditButton_Clicked"
                Style="{StaticResource AddButtonStyle}"></Button>
        <Button Text="Load tasks"
                Grid.Row="2"
                Grid.Column="2"
                MaximumHeightRequest="50"
                Clicked="LoadButton_Clicked"
                Style="{StaticResource AddButtonStyle}"></Button>
    </Grid>
</ContentPage>
