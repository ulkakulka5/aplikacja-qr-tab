<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lista_zakupow.MainPage"
             BackgroundColor="#66717E"
             Shell.NavBarIsVisible="False">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="0.8*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <VerticalStackLayout
    Grid.Row="0"
    Grid.Column="2"
    Grid.ColumnSpan="1"
    Grid.RowSpan="3"
    Margin="0,0,0,0"
            VerticalOptions="Center">

            <Button
        Text="Usuń"
        x:Name="Delete"
        Clicked="Delete_Clicked"
        WidthRequest="180"
        HeightRequest="40"
        BackgroundColor="#383B53"
        TextColor="#D4D6B9"
        FontSize="16"
        CornerRadius="10"
        BorderWidth="0"
        Padding="0"
        Margin="30">

                <Button.Shadow>
                    <Shadow
                Brush="#000000"
                Offset="4,5"
                Radius="10"
                Opacity="0.30" />
                </Button.Shadow>

            </Button>

            <Button
        Text="Zeskanuj nowy kod"
        x:Name="AddQR"
        Clicked="AddQR_Clicked"
        WidthRequest="180"
        HeightRequest="40"
        BackgroundColor="#383B53"
        TextColor="#D4D6B9"
        FontSize="16"
        CornerRadius="10"
        BorderWidth="0"
        Padding="0"
        Margin="30">

                <Button.Shadow>
                    <Shadow
                Brush="#000000"
                Offset="4,5"
                Radius="10"
                Opacity="0.30" />
                </Button.Shadow>

            </Button>

            <Button
        Text="Edytuj"
        x:Name="EditButton"
        Clicked="EditButton_Clicked"
        WidthRequest="180"
        HeightRequest="40"
        BackgroundColor="#383B53"
        TextColor="#D4D6B9"
        FontSize="16"
        CornerRadius="10"
        BorderWidth="0"
        Padding="0"
        Margin="30">

                <Button.Shadow>
                    <Shadow
                Brush="#000000"
                Offset="4,5"
                Radius="10"
                Opacity="0.30" />
                </Button.Shadow>

            </Button>

        </VerticalStackLayout>



        <Border
    StrokeShape="RoundRectangle 20"
    BackgroundColor="#D9D9D9"
    Grid.Row="1"
    Grid.Column="0"
    Grid.ColumnSpan="2"
    Margin="45,0,0,0">

            <CollectionView
        x:Name="list"
        ItemsSource="{Binding Products}"
        SelectionMode="Single"
        Style="{StaticResource listStyle}"
        BackgroundColor="#D9D9D9">



                <CollectionView.Header>
                    <Grid ColumnDefinitions="*,*,*">
                        <Label
                            Grid.Column="0"
                            Text="Numer urządzenia"
                            TextColor="Black"
                            FontSize="20"
                            Margin="20,10,0,10" />
                        <Label
                            Grid.Column="1"
                            Text="Imię, nazwisko, klasa"
                            TextColor="Black"
                            FontSize="20"
                            Margin="20,10,0,10" />
                        <Label
                            Grid.Column="2"
                            Text="Data"
                            TextColor="Black"
                            FontSize="20"
                            Margin="20,10,0,10" />
                    </Grid>
                </CollectionView.Header>



                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,*,*" Padding="10">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#D9D9D9" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#D4D6B9" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Label
                Grid.Column="0"
                Text="{Binding NumerUrzadzenia}"
                TextColor="Black" />

                            <Label
                Grid.Column="1"
                Text="{Binding ImieNazwiskoKLasa}"
                TextColor="Black" />

                            <Label
                Grid.Column="2"
                Text="{Binding Data, StringFormat='{0:g}'}"
                TextColor="Black" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Border>
        <Line
    Grid.Row="0"
    Grid.Column="0"
    Grid.RowSpan="3"
    Grid.ColumnSpan="3"
    X1="300"
    Y1="130"
    X2="300"
    Y2="540"
    Stroke="#AEAEAE"
    StrokeThickness="3"
    
     />

        <Line
Grid.Row="0"
Grid.Column="0"
Grid.RowSpan="3"
Grid.ColumnSpan="3"
X1="600"
Y1="130"
X2="600"
Y2="540"
Stroke="#AEAEAE"
StrokeThickness="3"

 />




    </Grid>
</ContentPage>