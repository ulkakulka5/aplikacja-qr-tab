<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lista_zakupow.EditTaskPage"
             Title="EditTaskPage">
    <VerticalStackLayout Spacing="5"
                         Margin="5">
        <Label Text="Numer Urzadzenia:" />
        <Entry x:Name="TytulEntry" />
        <Label Text="Imie, Nazwisko, Klasa:" />
        <Entry x:Name="RezyserEntry" />
        <Label Text="Data:" />
        <Entry x:Name="RokProdukcjiEntry" />
        <Button Text="Edytuj film" Clicked="OnEdytujFilmClicked" />
    </VerticalStackLayout>
</ContentPage>